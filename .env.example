# Copy this file to .env for local development. Never commit real secrets.
# Generate a persistent local key with:
# python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=replace-with-a-persistent-local-only-random-value

# Optional locally because the repository-relative database is the default.
# Set an absolute path for deployment and whenever operating on a copy.
DMV_BUS_STOPS_DB=src/database/dmv_bus_stops.db

# Local HTTP normally uses 0. Production HTTPS must use 1.
SESSION_COOKIE_SECURE=0

# Email sign-in is optional for anonymous local review. To test without sending
# mail, set this only in a non-production local environment.
REVIEWER_AUTH_DEV_MODE=1

# Provider-neutral authenticated SMTP. Obtain actual Resend values from its
# dashboard after sender/domain verification; do not commit credentials.
REVIEWER_EMAIL_BACKEND=smtp
REVIEWER_EMAIL_FROM=verified-sender@example.invalid
SMTP_HOST=replace-with-provider-smtp-host
SMTP_PORT=replace-with-provider-smtp-port
SMTP_USE_TLS=1
SMTP_USERNAME=replace-with-provider-username
SMTP_PASSWORD=replace-with-provider-password
