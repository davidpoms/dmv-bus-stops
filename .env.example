# Copy this file to .env for local development. Never commit real secrets.
# Generate a persistent local key with:
# python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=replace-with-a-persistent-local-only-random-value

# Optional locally because the repository-relative database is the default.
# Set an absolute path for deployment and whenever operating on a copy.
DMV_BUS_STOPS_DB=src/database/dmv_bus_stops.db

# Local HTTP normally uses 0. Production HTTPS must use 1.
SESSION_COOKIE_SECURE=0

# Required by the production pilot runner. Use the monitored address or URL
# that volunteers should use when a review cannot be completed.
PILOT_SUPPORT_CONTACT=mdcdsatransit@gmail.com

# Production runner bind settings. Keep the app behind an HTTPS terminator;
# do not expose this HTTP listener directly to the internet.
PILOT_BIND_HOST=127.0.0.1
PILOT_BIND_PORT=8080
LOG_LEVEL=INFO

# Email sign-in is optional for anonymous local review. To test without sending
# mail, set this only in a non-production local environment.
REVIEWER_AUTH_DEV_MODE=1

# Leave REVIEWER_EMAIL_BACKEND unset if the pilot is anonymous-only. If email
# login is advertised, uncomment and supply the complete provider configuration.
# PythonAnywhere free accounts can use Resend over HTTPS after domain verification:
# REVIEWER_EMAIL_BACKEND=resend
# REVIEWER_EMAIL_FROM=DMV Bus Stops <login@dmvbusstop.org>
# RESEND_API_KEY=<secret>

# Provider-neutral authenticated SMTP remains available on hosts that allow it:
# REVIEWER_EMAIL_BACKEND=smtp
# REVIEWER_EMAIL_FROM=verified-sender@example.invalid
# SMTP_HOST=replace-with-provider-smtp-host
# SMTP_PORT=replace-with-provider-smtp-port
# SMTP_USE_TLS=1
# SMTP_USERNAME=replace-with-provider-username
# SMTP_PASSWORD=replace-with-provider-password
