"""
Canonical bus stop model.

Every stage of the pipeline should operate on this object rather than
raw CSV rows or GeoJSON features.

The philosophy is:

Raw data
    ↓
BusStop
    ↓
Analysis
    ↓
Database
    ↓
API
"""

from dataclasses import dataclass, field
from typing import Optional, List


@dataclass
class BusStop:
    """
    Represents one physical bus stop.
    """

    ############################################################
    # Identity
    ############################################################

    stop_id: str

    ############################################################
    # Location
    ############################################################

    latitude: float
    longitude: float

    ############################################################
    # Agency metadata
    ############################################################

    route_ids: List[str] = field(default_factory=list)

    stop_name: Optional[str] = None

    jurisdiction: Optional[str] = None

    ############################################################
    # Existing infrastructure
    ############################################################

    has_bench: Optional[bool] = None

    has_shelter: Optional[bool] = None

    ############################################################
    # Volunteer review
    ############################################################

    review_count: int = 0

    confidence: float = 0.0

    ############################################################
    # Candidate scoring
    ############################################################

    estimated_wait_demand: Optional[float] = None

    bench_priority_score: Optional[float] = None

    ############################################################
    # Images
    ############################################################

    streetview_images: List[str] = field(default_factory=list)

    ############################################################
    # OSM
    ############################################################

    osm_shelter: Optional[bool] = None

    osm_bench: Optional[bool] = None

    ############################################################
    # Misc.
    ############################################################

    notes: List[str] = field(default_factory=list)

    def needs_review(self) -> bool:
        """
        Returns True if this stop should still be reviewed.
        """

        return self.confidence < 0.90

    def is_candidate_for_bench(self) -> bool:
        """
        Returns True if the stop currently appears to lack a bench.
        """

        return self.has_bench is False

    def add_note(self, text: str) -> None:
        self.notes.append(text)
